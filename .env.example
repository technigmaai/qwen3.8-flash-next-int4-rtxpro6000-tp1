# Copy to .env; replace /home/your-user and UID/GID with your Linux account.
# Literal values only: no $HOME, ~, substitutions or references to other keys.
IMAGE=technigmaai/qwen3.8-flash-next-int4-rtxpro6000-tp1:v1.0.0-sm120-amd64-cu130
COMPOSE_PROJECT_NAME=qwen38-rtxpro6000
CONTAINER_NAME=qwen38-rtxpro6000
GPU_DEVICE=0
HOST_UID=1000
HOST_GID=1000
API_PORT=8000
# Mount the COMPLETE model repo: blobs/ and snapshots/, not just a snapshot.
MODEL_HOST_DIR=/home/your-user/.cache/huggingface/hub/models--azampatti--Qwen3.8-Flash-Next-125B-A5B-INT4-AutoRound
MODEL_REVISION=1464274120d36a4d8fcaa934552334a7d83ce0fd
# Empty/generated deployment data, NOT the original model directory.
RUNTIME_HOST_DIR=/home/your-user/.cache/qwen38-rtxpro6000
# Both aliases route to one loaded checkpoint. These are not separate models.
MODEL_ALIASES='azampatti/Qwen3.8-Flash-Next-125B-A5B-INT4-AutoRound rtx'
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
# Decimal 13 GB, not 13 GiB. Shared pool; NOT eight full 512k contexts.
KV_CACHE_MEMORY_BYTES=13000000000
KV_CACHE_DTYPE=fp8_e4m3
# Keep bf16 for v1.0.0; fp8 requires the patched v1.0.1 candidate/runtime.
# Tested RC overrides: candidate IMAGE, KV_CACHE_MEMORY_BYTES=15000000000,
# INDEXER_KV_DTYPE=fp8. See README; stable default values remain unchanged.
INDEXER_KV_DTYPE=bf16
MTP_TOKENS=3
DRAFT_LOGIT_SCALE=2
